---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person } from '../site';

interface Props {
  /** Full, unique <title>. Must include "Sabir Saluja, MD" and "Radiology Resident". */
  title: string;
  /** Unique meta description. Must include "Sabir Saluja, MD" and "Radiology Resident". */
  description: string;
  /** Extra JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Set for pages that should stay out of search results (e.g. 404). */
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/images/sabir-saluja-md-headshot.jpg', Astro.site);
const socialImageAlt = `Headshot of ${person.fullName}, ${person.title} at ${person.institution}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.fullName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11151b" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="profile:first_name" content="Sabir" />
    <meta property="profile:last_name" content="Saluja" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
