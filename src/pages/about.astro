---
import Base from '../layouts/Base.astro';
import CvSection from '../components/CvSection.astro';
import { education, honors, interests, research, service, training } from '../data/cv';
import { getPresentations, getPublications } from '../lib/collections';

const publicationCount = (await getPublications()).length;
const presentationCount = (await getPresentations()).length;
---

<Base
  title="About & CV | Sabir Saluja, MD, Radiology Resident"
  description="Curriculum vitae of Sabir Saluja, MD, Radiology Resident at Montefiore Medical Center: residency and internship training, education, research experience, interests, and honors."
>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">About &amp; CV</p>
      <h1>Sabir Saluja, MD</h1>
      <p>
        Radiology Resident at Montefiore Medical Center in the Bronx, New York.
      </p>
    </header>

    <div class="layout">
      <div>
        <CvSection id="training" heading="Training" entries={training} />
        <CvSection id="education" heading="Education" entries={education} />
        <CvSection id="research" heading="Research experience" entries={research} />
        <CvSection id="honors" heading="Honors" entries={honors} />
        <CvSection id="service" heading="Service and volunteering" entries={service} />
      </div>

      <aside class="sidebar" aria-label="Summary">
        <section aria-labelledby="interests-heading">
          <h2 id="interests-heading">Interests</h2>
          <h3>Clinical</h3>
          <ul class="tag-list">{interests.clinical.map((item) => <li>{item}</li>)}</ul>
          <h3>Research</h3>
          <ul class="tag-list">{interests.research.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section aria-labelledby="scholarship-heading">
          <h2 id="scholarship-heading">Scholarship</h2>
          <ul class="link-list">
            <li><a href="/publications/">{publicationCount} publications</a></li>
            <li><a href="/presentations/">{presentationCount} oral presentations</a></li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--space-xl);
  }
  .layout > div > :global(.cv-section:first-child h2) {
    margin-top: 0;
  }

  .sidebar {
    order: -1;
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .sidebar section {
    padding: var(--space-m);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  .sidebar h2 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-s);
  }
  .sidebar h3 {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-s) 0 var(--space-2xs);
  }
  .sidebar h2 + h3 {
    margin-top: 0;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .link-list li + li {
    margin-top: var(--space-2xs);
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-2xl);
    }
    .sidebar {
      order: 0;
      position: sticky;
      top: var(--space-l);
    }
  }
</style>
