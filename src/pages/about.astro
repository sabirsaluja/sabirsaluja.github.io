---
import Base from '../layouts/Base.astro';
import CvSection from '../components/CvSection.astro';
import { education, interests, training } from '../data/cv';
import { cvUrl } from '../site';
---

<Base
  title="About | Sabir Saluja, MD, Radiology Resident"
  description="About Sabir Saluja, MD, Radiology Resident at Montefiore Medical Center: residency and internship training, education, clinical and research interests, and full CV."
>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">About</p>
      <h1>Sabir Saluja, MD</h1>
      <p>Radiology Resident at Montefiore Medical Center in the Bronx, New York.</p>
    </header>

    <div class="layout">
      <div>
        <CvSection id="training" heading="Training" entries={training} />
        <CvSection id="education" heading="Education" entries={education} />
      </div>

      <aside class="sidebar" aria-label="Summary">
        <section aria-labelledby="cv-heading">
          <h2 id="cv-heading">Curriculum vitae</h2>
          <p class="muted">Research experience, publications, presentations, and service.</p>
          <a class="btn btn-primary" href={cvUrl} target="_blank" rel="noopener">
            View CV (PDF)<span class="visually-hidden">, opens in a new tab</span>
          </a>
        </section>
        <section aria-labelledby="interests-heading">
          <h2 id="interests-heading">Interests</h2>
          <h3>Clinical</h3>
          <ul class="tag-list">{interests.clinical.map((item) => <li>{item}</li>)}</ul>
          <h3>Research</h3>
          <ul class="tag-list">{interests.research.map((item) => <li>{item}</li>)}</ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--space-xl);
  }
  .layout > div > :global(.cv-section:first-child h2) {
    margin-top: 0;
  }

  .sidebar {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .sidebar section {
    padding: var(--space-m);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
  }
  .sidebar h2 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-xs);
  }
  .sidebar p {
    font-size: var(--step--1);
  }
  .sidebar h3 {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-s) 0 var(--space-2xs);
  }
  .sidebar h2 + h3 {
    margin-top: 0;
  }

  @media (max-width: 55.99rem) {
    .sidebar {
      order: -1;
    }
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-2xl);
    }
  }
</style>
